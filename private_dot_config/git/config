[alias]
  a        = add
  as       = !git add -A
  as       = !git add -A && git status
  au       = !git add -u
  aus      = !git add -u && git status
  br       = branch
  brd      = branch -d
  cl       = clone
  clb      = clone -b
  cm       = commit
  cma      = commit --amend
  cmm      = commit -m
  cmma     = commit -m "add"
  cmmu     = commit -m "update"
  cp       = cherry-pick
  d        = diff
  del      = reset --soft HEAD^
  diffnpst = !git --no-pager diff --staged
  ds       = diff --staged
  fe       = fetch
  ev       = !git add -A && git commit -m "wip" && git push origin HEAD
  i        = init
  ic       = !git commit --allow-empty -m "Initial commit"
  lg       = log
  lgnp     = !git --no-pager log
  lgp      = log -p
  lgp1     = log -p -1
  mg       = merge
  mgt      = mergetool
  s        = status
  sh       = stash
  ps       = push
  pso      = push origin
  psoh     = push origin HEAD
  pl       = pull
  plo      = pull origin
  ploh     = pull origin HEAD
  plus     = pull upstream
  rb       = rebase
  rs       = restore
  si       = switch
  sic      = switch -c
  sim      = switch main
  sid      = switch develop
  so       = show
  us       = reset HEAD
  wt       = worktree

[user]
  name       = 音㦡
  email      = 215371699+0ngk@users.noreply.github.com
  signingkey = 85A6A9286F89E4C3

[credential "https://github.com"]
  helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper = !/usr/bin/gh auth git-credential

[commit]
  gpgsign = true

[core]
  quotepath = false
	excludesFile = /Users/rei/.config/git/ignore
	pager = delta

[init]
  defaultBranch = main

[push]
  useForceIfIncludes = true

[tag]
  gpgsign = true

[filter "lfs"]
  clean    = git-lfs clean -- %f
  smudge   = git-lfs smudge -- %f
  process  = git-lfs filter-process
  required = true

[mergetool "neovimdiff"]
  cmd = nvim -d $LOCAL $MERGED $REMOTE -c 'wincmd l' -c 'wincmd J'

[merge]
  tool = neovimdiff
	conflictStyle = zdiff3
	trustExitCode = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
  keep-plus-minus-markers = true

[includeIf "gitdir:~/sc/"]
  path = ~/sc/_git/config

[includeIf "gitdir:~/pgm/dev/css/"]
  path = ~/pgm/dev/css/_git/config

[includeIf "gitdir:~/pgm/work/"]
  path = ~/pgm/work/_git/config

